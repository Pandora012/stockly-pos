# Copy to .env and replace development-only values. Never commit the copy.
POSTGRES_PASSWORD=replace-with-local-database-password
DATABASE_URL=postgresql://stockly:replace-with-local-database-password@localhost:5432/stockly?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Public API origin accessed by the browser, no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Required when web and API are on different sites in production: none (HTTPS only).
COOKIE_SAME_SITE=lax
# Set only when running npm run db:seed; never use example values in production.
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-with-a-unique-strong-password
ADMIN_NAME=Store Admin
STORE_NAME=Stockly Store
