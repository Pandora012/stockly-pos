{
  "name": "stockly-pos",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w @stockly/web",
    "dev:api": "npm run dev -w @stockly/api",
    "build": "npm run build -w @stockly/web",
    "lint": "npm run lint -w @stockly/web && npm run lint -w @stockly/api",
    "test": "npm run test -w @stockly/api",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "next": "^15.5.28",
    "prisma": "^6.19.0"
  }
}
